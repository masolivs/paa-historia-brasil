# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=historia_brasil

# Ollama (instalado separadamente na máquina)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Alternativa menor, se compatível com o hardware: smollm2:1.7b

# Embeddings: mantenha este mesmo modelo no pré-processamento, ingestão e API
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHUNK_MAX_TOKENS=100
CHUNK_OVERLAP_TOKENS=15

# API
TOP_K_RESULTS=4
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MOCK_MODE=false

# Avaliação RAGAS
EVAL_API_URL=http://localhost:8000/api/ask
EVAL_TOP_K=4
# Idealmente configure um modelo avaliador diferente do modelo que gera as respostas.
RAGAS_LLM_MODEL=qwen2.5:3b
EVAL_QUESTIONS_FILE=evaluation/test_questions.json

RAG_MANIFEST=embeddings-pilot/e5-small/manifest.json
RAG_RETRIEVAL=hnsw
RAG_EF=200
RAG_TEMPERATURE=0.2